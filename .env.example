# Copie este arquivo para .env e preencha. O .env nunca vai pro Git.
# Usado pelo coletor (npm run coletar) e pelo gerador do site (npm run dados:site).

# Supabase > Connect > Session pooler (IPv4, porta 5432), com [YOUR-PASSWORD] trocado pela senha do banco.
# Ex.: postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Google AI Studio. Opcional: sem ela o coletor pula os resumos e o site mostra a manchete original.
GEMINI_API_KEY=

# Groq (console.groq.com). Opcional: IA de reserva dos resumos, quando o Gemini falha ou fica sem cota.
GROQ_API_KEY=

# Mistral (console.mistral.ai). Opcional: vetores dos títulos para agrupar as matérias pelo sentido.
# Sem ela, o agrupamento compara só as palavras dos títulos.
MISTRAL_API_KEY=
