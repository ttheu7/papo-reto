---
import Base from '../layouts/Base.astro';
import ListaDeNoticias from '../components/ListaDeNoticias.astro';
import Medidor from '../components/Medidor.astro';
import ImagemIlustrativa from '../components/ImagemIlustrativa.astro';
import { categorias, eventos, hoje, imagemNaCapa, portaisAtuais } from '../lib/dados';
import { caminho, exigeAssinatura, lerNo, plural, portaisDe, quando, quemNoticiou, REPOSITORIO } from '../lib/formato';

const geradoEm = eventos.geradoEm;
const doDia = hoje.eventos.length > 0 ? hoje.eventos : eventos.eventos.slice(0, 5);
const [manchete, ...tambem] = doDia;
const idsDoDia = new Set(doDia.map((e) => e.id));
const ultimas = eventos.eventos.filter((e) => !idsDoDia.has(e.id));
const editorias = categorias.categorias
  .filter((c) => c.total > 0)
  .sort((a, b) => b.total - a.total)
  .map((c) => ({ ...c, eventos: eventos.eventos.filter((e) => e.categoria?.slug === c.slug && e.id !== manchete?.id).slice(0, 3) }))
  .filter((c) => c.eventos.length > 0);
const portais = portaisAtuais();
const fonteDaManchete = manchete?.materias[0];
const fotoDaManchete = imagemNaCapa(manchete);
---
<Base capa titulo="Papo Reto: as notícias do dia, explicadas" descricao="As notícias do dia explicadas em até quatro frases, com link para quem noticiou. Grátis, sem anúncio e sem cadastro.">
  {manchete && (
    <section class="capa moldura" aria-labelledby="manchete-titulo">
      <article class="manchete">
        {manchete.categoria && <a class="chapeu" href={caminho(`categoria/${manchete.categoria.slug}/`)}>{manchete.categoria.nome}</a>}
        <h2 class="manchete__titulo" id="manchete-titulo"><a href={caminho(`evento/${manchete.id}/`)}>{manchete.titulo}</a></h2>
        {fotoDaManchete && <ImagemIlustrativa imagem={fotoDaManchete} prioridade class="manchete__foto" />}
        <p class="manchete__resumo">{manchete.resumo ?? 'Ainda sem resumo. Leia a manchete original direto no portal.'}</p>
        <p class="servico">
          <Medidor cobertura={manchete.cobertura} />
          <span>Noticiado por {portaisDe(manchete).join(', ')} · <time datetime={manchete.publicadoEm}>{quando(manchete.publicadoEm, geradoEm)}</time></span>
        </p>
        <div class="manchete__acoes">
          <a class="botao" href={caminho(`evento/${manchete.id}/`)}>Entender o assunto</a>
          {fonteDaManchete && (
            <a class="link manchete__fonte" href={fonteDaManchete.url} rel="noopener">
              {lerNo(fonteDaManchete.portal)}{exigeAssinatura(manchete) ? ' (exige assinatura)' : ''}
            </a>
          )}
        </div>
        {manchete.resumo && <p class="manchete__ia">Resumo feito por IA a partir das manchetes dos portais.</p>}
      </article>

      {tambem.length > 0 && (
        <aside class="tambem" aria-labelledby="tambem-titulo">
          <h2 class="rotulo" id="tambem-titulo">Também hoje</h2>
          <ol class="tambem__lista" data-revela>
            {tambem.map((e) => (
              <li class="item">
                {e.categoria && <p class="chapeu">{e.categoria.nome}</p>}
                <h3><a class="estica" href={caminho(`evento/${e.id}/`)}>{e.titulo}</a></h3>
                <p class="servico">
                  <Medidor cobertura={e.cobertura} />
                  <span>{quemNoticiou(e)} · <time datetime={e.publicadoEm}>{quando(e.publicadoEm, geradoEm)}</time></span>
                </p>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </section>
  )}

  {editorias.length > 0 && (
    <section class="secao moldura" aria-labelledby="editorias-titulo">
      <h2 class="so-leitor" id="editorias-titulo">Por editoria</h2>
      <ul class="editorias" data-revela>
        {editorias.map((c) => (
          <li class="bloco">
            <h3 class="rotulo bloco__nome"><a href={caminho(`categoria/${c.slug}/`)}>{c.nome}</a><span>{c.total}</span></h3>
            <ul>
              {c.eventos.map((e) => (
                <li class="item bloco__item">
                  <h4><a class="estica" href={caminho(`evento/${e.id}/`)}>{e.titulo}</a></h4>
                  <p class="servico"><Medidor cobertura={e.cobertura} /> <span>{quemNoticiou(e)} · <time datetime={e.publicadoEm}>{quando(e.publicadoEm, geradoEm)}</time></span></p>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="secao moldura" id="ultimas" aria-labelledby="ultimas-titulo">
    <div class="secao__titulo">
      <h2 id="ultimas-titulo">Últimas notícias</h2>
      <p>{plural(ultimas.length, 'notícia', 'notícias')} das últimas 48 horas</p>
    </div>
    <ListaDeNoticias eventos={ultimas} geradoEm={geradoEm} filtro porVez={16} />
  </section>

  <section class="secao moldura" aria-labelledby="sobre-titulo">
    <div class="sobre">
      <div class="carta" data-revela>
        <p class="chapeu">Carta ao leitor</p>
        <h2 id="sobre-titulo">Grátis, sem anúncio e sem cadastro</h2>
        <p>A gente é uma turma de Ciência da Computação da Unoesc Videira, em Santa Catarina. Fizemos o Papo Reto porque notícia boa existe, mas chega espalhada em dez portais e escrita para quem já sabe do assunto.</p>
        <p>Aqui cada notícia vem explicada em até quatro frases e sempre com o link de quem apurou. Para ler a matéria inteira, você vai até o portal: o trabalho é deles.</p>
        <p>O código é aberto. Se um resumo estiver errado, cada notícia tem um botão para avisar, e a correção fica registrada no GitHub.</p>
        <p class="carta__assinatura">Turma de PRATIC IV, Unoesc Videira</p>
        <a class="botao botao--papel" href={REPOSITORIO}>Ver o código</a>
      </div>
      <div class="feita" data-revela>
        <p class="chapeu">Expediente</p>
        <h2>Como a edição é feita</h2>
        <div>
          <h3>A cada 30 minutos</h3>
          <p>Um programa lê as manchetes que {plural(portais.length, 'portal publica', 'portais publicam')} nos seus feeds: {portais.slice(0, 4).map((p) => p.nome).join(', ')} e outros.</p>
        </div>
        <div>
          <h3>A IA explica</h3>
          <p>Um modelo de IA escreve até quatro frases usando só o título e a descrição dos portais, sem inventar nada.</p>
        </div>
        <div>
          <h3>Você vai à fonte</h3>
          <p>Cada notícia mostra quem publicou e leva até a matéria original.</p>
        </div>
        <a class="link feita__mais" href={caminho('como-funciona/')}>Ver como funciona</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Capa: a manchete e a coluna "Também hoje", separadas por um fio ---------- */
  .capa {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    padding-top: var(--gutter); padding-bottom: 0;
  }
  .capa > * { padding-bottom: var(--gutter); }
  .manchete { display: grid; gap: 14px; align-content: start; justify-items: start; padding-right: calc(var(--gutter) * 1.25); border-right: 1px solid var(--fio-claro); }
  .manchete__titulo { font-size: var(--step-head); font-weight: 740; line-height: 1.02; letter-spacing: -0.02em; }
  .manchete__titulo a { text-decoration: underline; text-decoration-thickness: 0.04em; text-decoration-color: transparent; transition: text-decoration-color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .manchete__titulo a:hover { text-decoration-color: currentColor; } }
  .manchete :global(.manchete__foto) { justify-self: stretch; }
  .manchete :global(.manchete__foto img) { aspect-ratio: 2 / 1; }
  .manchete__resumo { font-size: var(--step-lead); line-height: 1.42; columns: 2 18em; column-gap: calc(var(--gutter) * 1.25); column-rule: 1px solid var(--fio-claro); }
  /* Capitular: a primeira letra do resumo, como na abertura de matéria do jornal. */
  .manchete__resumo::first-letter { float: left; font-size: 3.4em; line-height: 0.82; font-weight: 740; padding: 0.06em 0.08em 0 0; }
  .manchete__acoes { display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: center; padding-top: 4px; }
  .manchete__fonte { display: inline-flex; align-items: center; min-height: 44px; font: 600 var(--step-small) var(--sans); text-decoration-color: currentColor; }
  .manchete__ia { font: 400 var(--step-small) var(--sans); color: var(--muted); }

  .tambem { padding-left: calc(var(--gutter) * 1.25); }
  .tambem__lista li { display: grid; gap: 6px; padding: 14px 0 16px; border-bottom: 1px solid var(--fio-claro); }
  .tambem__lista h3 { font-size: var(--step-lead); font-weight: 650; line-height: 1.15; }

  /* ---------- Por editoria: colunas com fio entre elas ---------- */
  .editorias { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); column-gap: calc(var(--gutter) * 2); row-gap: var(--respiro); }
  .bloco__nome { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .bloco__nome span { font-variant-numeric: tabular-nums; letter-spacing: 0; color: var(--muted); }
  .bloco__item { display: grid; gap: 4px; padding: 12px 0 14px; border-bottom: 1px solid var(--fio-claro); }
  .bloco__item:last-child { border-bottom: 0; }
  .bloco__item h4 { margin: 0; font: 650 var(--step-body) / 1.22 var(--serif); }

  /* ---------- Carta e expediente ---------- */
  .sobre { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); border-top: 3px solid var(--fio); border-bottom: 1px solid var(--fio); }
  .carta, .feita { display: grid; gap: 14px; align-content: start; justify-items: start; padding: var(--dentro) 0; }
  .carta { padding-right: calc(var(--gutter) * 1.5); }
  .feita { padding-left: calc(var(--gutter) * 1.5); border-left: 1px solid var(--fio-claro); }
  .carta h2, .feita > h2 { font-size: var(--step-lead); font-weight: 720; }
  .carta p { max-width: 62ch; }
  .carta__assinatura { font-style: italic; }
  .feita > div { display: grid; gap: 2px; }
  .feita h3 { font: 600 var(--step-small) / 1.3 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; }
  .feita__mais { display: inline-flex; align-items: center; min-height: 44px; font: 600 var(--step-small) var(--sans); letter-spacing: 0.08em; text-transform: uppercase; text-decoration-color: currentColor; }

  @media (max-width: 900px) {
    .capa { grid-template-columns: 1fr; }
    .manchete { padding-right: 0; border-right: 0; border-bottom: 1px solid var(--fio-claro); }
    .tambem { padding-left: 0; padding-top: var(--gutter); }
    .sobre { grid-template-columns: 1fr; }
    .carta { padding-right: 0; }
    .feita { padding-left: 0; border-left: 0; border-top: 1px solid var(--fio-claro); }
  }
</style>
