---
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import ListaDeNoticias from '../../components/ListaDeNoticias.astro';
import { categorias, eventos, eventosDaCategoria } from '../../lib/dados';
import { caminho, plural } from '../../lib/formato';

export function getStaticPaths() {
  return categorias.categorias.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug, nome: c.nome } }));
}

const { slug, nome } = Astro.props as { slug: string; nome: string };
const lista = eventosDaCategoria(slug);
const outras = categorias.categorias.filter((c) => c.slug !== slug);
---
<Base titulo={`${nome} | Papo Reto`} descricao={`Notícias de ${nome.toLowerCase()} das últimas 48 horas, explicadas em até quatro frases.`}>
  <Cabecalho grande cat={slug}>
    <h1 id="pagina-titulo">{nome}</h1>
    <p class="abre__apoio">
      {lista.length > 0 ? `${plural(lista.length, 'notícia', 'notícias')} de ${nome.toLowerCase()} nas últimas 48 horas, explicadas em até quatro frases.` : `Nada de ${nome.toLowerCase()} nas últimas 48 horas.`}
    </p>
  </Cabecalho>

  <section class="moldura lista" aria-labelledby="lista-titulo">
    <h2 class="so-leitor" id="lista-titulo">Notícias de {nome}</h2>
    {lista.length > 0 ? (
      <ListaDeNoticias eventos={lista} geradoEm={eventos.geradoEm} mostrarCategoria={false} />
    ) : (
      <p class="vazio card">Enquanto isso, veja <a class="link" href={caminho()}>as notícias do dia</a> ou outra editoria logo abaixo.</p>
    )}
  </section>

  <section class="secao moldura" aria-labelledby="outras-titulo">
    <div class="cabeca"><h2 id="outras-titulo">Outras editorias</h2></div>
    <ul class="outras" data-revela>
      {outras.map((c) => (
        <li data-cat={c.slug}>
          <a href={caminho(`categoria/${c.slug}/`)}>
            <span>{c.nome}</span>
            <span class="outras__total">{plural(c.total, 'notícia', 'notícias')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .lista { padding-top: var(--gutter); }
  .vazio { font-size: var(--step-lead); }
  .outras { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .outras a {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 72px; padding: 0 22px;
    background: var(--cat); border-radius: var(--raio); text-decoration: none;
    font-family: var(--serif); font-weight: 560; font-size: var(--step-lead);
    transition: filter var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .outras a:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .outras a:hover { filter: brightness(0.95); } }
  .outras__total { font-family: var(--sans); font-size: var(--step-small); font-weight: 600; font-variant-numeric: tabular-nums; }
</style>
