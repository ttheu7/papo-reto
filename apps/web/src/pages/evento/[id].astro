---
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import ListaDeNoticias from '../../components/ListaDeNoticias.astro';
import { eventos, type Evento } from '../../lib/dados';
import { caminho, dataPorExtenso, linkParaReportar, plural, portaisDe, quando } from '../../lib/formato';

export function getStaticPaths() {
  return eventos.eventos.map((e) => ({ params: { id: e.id }, props: { evento: e } }));
}

const { evento: e } = Astro.props as { evento: Evento };
const geradoEm = eventos.geradoEm;
const portais = portaisDe(e);
const relacionados = e.categoria ? eventos.eventos.filter((x) => x.id !== e.id && x.categoria?.slug === e.categoria?.slug).slice(0, 4) : [];
const descricao = e.resumo ?? `${e.titulo}. Veja quem noticiou e leia a matéria original.`;
---
<Base titulo={`${e.titulo} | Papo Reto`} descricao={descricao}>
  <Cabecalho cat={e.categoria?.slug ?? 'geral'}>
    <h1 id="pagina-titulo">{e.titulo}</h1>
    <div class="lado">
      {e.categoria && <a class="editoria editoria--papel" href={caminho(`categoria/${e.categoria.slug}/`)}>{e.categoria.nome}</a>}
      <p><time datetime={e.publicadoEm}>{dataPorExtenso(e.publicadoEm)}, {quando(e.publicadoEm, geradoEm)}</time></p>
      <p>Noticiado por {plural(e.cobertura, 'portal', 'portais')}: {portais.join(', ')}</p>
    </div>
  </Cabecalho>

  <div class="moldura evento">
    <section class="minuto card" aria-labelledby="minuto-titulo" data-revela>
      <h2 id="minuto-titulo">Em 1 minuto</h2>
      {e.resumo ? (
        <>
          <p class="minuto__texto">{e.resumo}</p>
          <p class="minuto__aviso">
            Resumo gerado por IA a partir das manchetes e descrições de {portais.join(', ')}. Pode ter erros: confira na matéria original.
          </p>
          <a class="botao" href={linkParaReportar(e.id, e.titulo)}>Reportar erro neste resumo</a>
        </>
      ) : (
        <>
          <p class="minuto__texto">Este assunto ainda não tem resumo. Por enquanto, o melhor caminho é ler direto na fonte, logo ao lado.</p>
          <a class="botao" href={linkParaReportar(e.id, e.titulo)}>Reportar um problema</a>
        </>
      )}
    </section>

    <section class="quem card" aria-labelledby="quem-titulo">
      <h2 id="quem-titulo">Quem noticiou</h2>
      <ul class="quem__lista" data-revela>
        {e.materias.map((m) => (
          <li>
            <a class="quem__materia" href={m.url} rel="noopener">
              <span class="quem__portal">{m.portal}</span>
              <span class="quem__titulo">{m.titulo}</span>
              <span class="quem__meta">
                <time datetime={m.publicadaEm}>{quando(m.publicadaEm, geradoEm)}</time>
                {m.exigeAssinatura && <span class="assinatura">Exige assinatura</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  {relacionados.length > 0 && e.categoria && (
    <section class="secao moldura" aria-labelledby="relacionados-titulo">
      <div class="cabeca">
        <h2 id="relacionados-titulo">Mais de {e.categoria.nome}</h2>
        <a class="link" href={caminho(`categoria/${e.categoria.slug}/`)}>Ver todas</a>
      </div>
      <ListaDeNoticias eventos={relacionados} geradoEm={geradoEm} mostrarCategoria={false} />
    </section>
  )}
</Base>

<style>
  :global(.abre__folha):has(.lado) { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); align-items: end; gap: 24px var(--gutter); }
  .lado { display: grid; gap: 10px; justify-items: start; font-size: var(--step-small); font-weight: 600; }
  .lado p::first-letter { text-transform: uppercase; }
  @media (max-width: 900px) { :global(.abre__folha):has(.lado) { grid-template-columns: 1fr; } }
  .evento { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gutter); padding-top: var(--gutter); align-items: start; }
  .minuto, .quem { display: grid; gap: 22px; align-content: start; justify-items: start; }
  .minuto h2, .quem h2 { font-size: var(--step-head); }
  .minuto__texto { font-family: var(--serif); font-size: var(--step-lead); line-height: 1.45; max-width: 38ch; }
  .minuto__aviso { max-width: 52ch; }
  .quem { justify-items: stretch; }
  .quem__lista { display: grid; gap: 8px; }
  .quem__materia {
    display: grid; gap: 6px; padding: 16px 18px; border-radius: calc(var(--raio) - 6px); background: var(--papel-2);
    text-decoration: none; transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  .quem__materia:active { transform: scale(0.99); }
  @media (hover: hover) and (pointer: fine) {
    .quem__materia:hover { background: var(--cat-geral); }
    .quem__materia:hover .quem__titulo { text-decoration: underline; }
  }
  .quem__portal { font-weight: 600; font-size: var(--step-small); }
  .quem__titulo { font-family: var(--serif); font-size: var(--step-lead); line-height: 1.2; text-decoration-thickness: 1px; }
  .quem__meta { display: flex; gap: 12px; font-size: var(--step-small); color: var(--muted); }
  @media (max-width: 900px) { .evento { grid-template-columns: 1fr; gap: var(--respiro); padding-top: var(--respiro); } }
</style>
