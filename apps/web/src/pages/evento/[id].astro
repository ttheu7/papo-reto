---
import Base from '../../layouts/Base.astro';
import Cabecalho from '../../components/Cabecalho.astro';
import ListaDeNoticias from '../../components/ListaDeNoticias.astro';
import Medidor from '../../components/Medidor.astro';
import ImagemIlustrativa from '../../components/ImagemIlustrativa.astro';
import { eventos, type Evento } from '../../lib/dados';
import { caminho, dataPorExtenso, linkParaReportar, portaisDe, quando } from '../../lib/formato';

export function getStaticPaths() {
  return eventos.eventos.map((e) => ({ params: { id: e.id }, props: { evento: e } }));
}

const { evento: e } = Astro.props as { evento: Evento };
const geradoEm = eventos.geradoEm;
const portais = portaisDe(e);
const relacionados = e.categoria ? eventos.eventos.filter((x) => x.id !== e.id && x.categoria?.slug === e.categoria?.slug).slice(0, 4) : [];
const descricao = e.resumo ?? `${e.titulo}. Veja quem noticiou e leia a matéria original.`;
---
<Base titulo={`${e.titulo} | Papo Reto`} descricao={descricao}>
  <Cabecalho semFio={!e.imagem}>
    {e.categoria && <a class="chapeu" href={caminho(`categoria/${e.categoria.slug}/`)}>{e.categoria.nome}</a>}
    <h1 id="pagina-titulo">{e.titulo}</h1>
    <p class="servico">
      <Medidor cobertura={e.cobertura} categoria={e.categoria} />
      <span>Noticiado por {portais.join(', ')}</span>
      <span aria-hidden="true">·</span>
      <time class="data" datetime={e.publicadoEm}>{dataPorExtenso(e.publicadoEm)}, {quando(e.publicadoEm, geradoEm)}</time>
    </p>
  </Cabecalho>

  {e.imagem && (
    <div class="moldura foto-topo">
      <ImagemIlustrativa imagem={e.imagem} prioridade />
    </div>
  )}

  <div class="moldura evento">
    <section class="minuto" aria-labelledby="minuto-titulo" data-revela>
      <h2 class="rotulo minuto__rotulo" id="minuto-titulo">Em 1 minuto {e.resumo && <span class="carimbo-explicado" aria-hidden="true">Explicado</span>}</h2>
      {e.resumo ? (
        <>
          <p class="minuto__texto">{e.resumo}</p>
          <p class="minuto__aviso">
            Resumo gerado por IA a partir das manchetes e descrições de {portais.join(', ')}. Pode ter erros: confira na matéria original.
          </p>
          <a class="botao botao--papel" href={linkParaReportar(e.id, e.titulo)}>Reportar erro neste resumo</a>
        </>
      ) : (
        <>
          <p class="minuto__texto">Este assunto ainda não tem resumo. Por enquanto, o melhor caminho é ler direto na fonte, logo ao lado.</p>
          <a class="botao botao--papel" href={linkParaReportar(e.id, e.titulo)}>Reportar um problema</a>
        </>
      )}
    </section>

    <section class="quem" aria-labelledby="quem-titulo">
      <h2 class="rotulo" id="quem-titulo">Quem noticiou</h2>
      <Medidor cobertura={e.cobertura} categoria={e.categoria} grande />
      <ul class:list={["quem__lista", { "quem__lista--rola": e.materias.length > 2 }]} data-quem-lista data-revela>
        {e.materias.map((m) => (
          <li class="item quem__item">
            <p class="chapeu">{m.portal}</p>
            <a class="estica quem__titulo" href={m.url} rel="noopener">{m.titulo}</a>
            <p class="servico">
              <time datetime={m.publicadaEm}>{quando(m.publicadaEm, geradoEm)}</time>
              {m.exigeAssinatura && <span class="assinatura">· Exige assinatura</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </div>

  {relacionados.length > 0 && e.categoria && (
    <section class="secao moldura" aria-labelledby="relacionados-titulo">
      <div class="secao__titulo">
        <h2 id="relacionados-titulo">Mais de {e.categoria.nome}</h2>
        <a class="link mais" href={caminho(`categoria/${e.categoria.slug}/`)}>Ver todas</a>
      </div>
      <ListaDeNoticias eventos={relacionados} geradoEm={geradoEm} mostrarCategoria={false} />
    </section>
  )}
</Base>

<script>
  // "Quem noticiou" mostra duas fontes e meia; o resto rola. A metade cortada da terceira avisa que tem
  // mais. Cada manchete tem uma altura, então a conta é feita com os itens de verdade.
  const listas = document.querySelectorAll<HTMLElement>('[data-quem-lista].quem__lista--rola');
  const ajustar = () => {
    for (const lista of listas) {
      const [a, b, c] = lista.children as unknown as HTMLElement[];
      if (a && b && c) lista.style.maxHeight = `${a.offsetHeight + b.offsetHeight + c.offsetHeight / 2}px`;
    }
  };
  ajustar();
  addEventListener('resize', ajustar);
</script>

<style>
  .data::first-letter { text-transform: uppercase; }
  .foto-topo { padding-top: var(--gutter); }
  .foto-topo :global(img) { aspect-ratio: 21 / 9; max-height: 360px; }
  @media (max-width: 640px) { .foto-topo :global(img) { aspect-ratio: 4 / 3; } }
  /* Duas colunas com fio entre elas, da mesma altura (como colunas de uma página). */
  /* Duas colunas com fio entre elas. Sem foto, o cabeçalho não tem fio de baixo: quem abre a área é o
     fio forte dos rótulos, com mais espaço depois do título. Com foto, ela fica entre o fio do cabeçalho
     e o dos rótulos. */
  .evento { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: stretch; padding-top: calc(var(--gutter) * 1.5); }
  .foto-topo + .evento { padding-top: var(--gutter); }
  .minuto, .quem { display: grid; gap: 18px; align-content: start; justify-items: start; }
  .minuto { padding-right: calc(var(--gutter) * 1.5); border-right: 1px solid var(--fio-claro); }
  .quem { padding-left: calc(var(--gutter) * 1.5); justify-items: stretch; }
  .minuto .rotulo, .quem .rotulo { justify-self: stretch; }
  /* Os rótulos das duas colunas no estilo da casa (fio forte em cima, fino embaixo), com a mesma altura
     e um pouco mais de espaço, para o carimbo "Explicado" não encostar nos fios. */
  .minuto .rotulo, .quem .rotulo { display: flex; align-items: center; min-height: 64px; padding: 12px 0; }
  .minuto__texto { font-size: var(--step-lead); line-height: 1.45; max-width: 40ch; }
  .minuto__texto::first-letter { float: left; font-size: 3.2em; line-height: 0.82; font-weight: 740; padding: 0.06em 0.08em 0 0; }
  /* Carimbo "Explicado" batido no rótulo do resumo. */
  .minuto__rotulo { display: flex; align-items: center; gap: 14px; }
  .carimbo-explicado { display: inline-block; padding: 5px 8px 4px; border: 2px solid var(--ink); transform: rotate(-4deg); letter-spacing: 0.14em; }
  .minuto__aviso { font: 400 var(--step-small) / 1.45 var(--sans); color: var(--muted); max-width: 56ch; }
  /* Mais de duas fontes: altura fixa (duas e meia, ajustada pelo script) e rolagem sem barra. */
  .quem__lista--rola { max-height: 15rem; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
  .quem__lista--rola::-webkit-scrollbar { display: none; }
  .quem__item { display: grid; gap: 4px; padding: 12px 0 14px; border-bottom: 1px solid var(--fio-claro); }
  .quem__titulo { font: 650 var(--step-body) / 1.25 var(--serif); }
  .mais { font: 600 var(--step-small) var(--sans); letter-spacing: 0.08em; text-transform: uppercase; text-decoration-color: currentColor; }
  @media (max-width: 900px) {
    .evento { grid-template-columns: 1fr; }
    .minuto { padding-right: 0; border-right: 0; padding-bottom: var(--gutter); }
    .quem { padding-left: 0; }
  }
</style>
