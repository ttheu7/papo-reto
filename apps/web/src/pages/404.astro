---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import { caminho } from '../lib/formato';
---
<Base titulo="Página não encontrada | Papo Reto" descricao="Esta página não existe mais. Notícias saem do site depois de 48 horas.">
  <Cabecalho grande>
    <h1 id="pagina-titulo">Essa página não existe</h1>
    <p class="abre__apoio">Os acontecimentos saem do site depois de 48 horas. Talvez este já tenha saído.</p>
    <p><a class="botao" href={caminho()}>Ver as notícias do dia</a></p>
  </Cabecalho>
</Base>
