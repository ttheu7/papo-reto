---
// Giro: as manchetes em tela cheia, uma de cada vez, como nos vídeos curtos. Cada cartão traz só a manchete,
// o medidor de cobertura e, quando há, a imagem ilustrativa; tocar no cartão abre a notícia no site.
// A ordem é a mesma para todo mundo e a lista acaba: nada de rolagem infinita nem de personalização.
// Sem JavaScript, funciona com a rolagem que encaixa e os links "Próxima" e "Anterior".
import Base from '../layouts/Base.astro';
import Medidor from '../components/Medidor.astro';
import { eventos, eventosDoGiro } from '../lib/dados';
import { caminho, portaisDe, quando } from '../lib/formato';

const geradoEm = eventos.geradoEm;
const lista = eventosDoGiro();
const total = lista.length;
const id = (i: number) => `cena-${i + 1}`;
---
<Base imersivo titulo="Giro | Papo Reto" descricao="As manchetes do dia em tela cheia, uma de cada vez. Toque para abrir a notícia.">
  <div class="giro">
    <header class="giro__barra">
      <a class="giro__voltar" href={caminho()} aria-label="Voltar para a capa do Papo Reto">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span translate="no">Papo Reto</span>
      </a>
      <h1 class="giro__nome">Giro</h1>
      <p class="giro__contador" aria-hidden="true"><span data-giro-atual>1</span> de {total}</p>
    </header>

    <ol class="giro__lista" data-giro-lista tabindex="0" aria-label={`Giro: ${total} notícias. Use as setas para passar.`}>
      {lista.map((e, i) => {
        const portais = portaisDe(e);
        return (
          <li class="giro__cena" id={id(i)} data-giro-cena={i + 1}>
            <article class:list={['giro__cartao', { 'giro__cartao--foto': e.imagem }]} aria-labelledby={`${id(i)}-titulo`}>
              {e.imagem && (
                <img
                  class="giro__foto"
                  src={e.imagem.url}
                  width={e.imagem.largura || undefined}
                  height={e.imagem.altura || undefined}
                  alt=""
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  referrerpolicy="no-referrer"
                  style={e.imagem.cor ? `background-color:${e.imagem.cor}` : undefined}
                />
              )}
              <div class="giro__texto">
                <p class="so-leitor">Notícia {i + 1} de {total}</p>
                <h2 class="giro__manchete" id={`${id(i)}-titulo`}>
                  <a class="giro__abrir" href={caminho(`evento/${e.id}/`)}>{e.titulo}</a>
                </h2>
                <p class="giro__meta">
                  <Medidor cobertura={e.cobertura} categoria={e.categoria} />
                  <span>{portais.length === 1 ? portais[0] : `${portais.length} portais`} · <time datetime={e.publicadoEm}>{quando(e.publicadoEm, geradoEm)}</time></span>
                </p>
                {e.imagem && (
                  <p class="giro__credito">
                    Imagem ilustrativa · Foto: <a href={e.imagem.urlAutor} rel="noopener">{e.imagem.autor}</a> / <a href={e.imagem.urlPagina} rel="noopener">{e.imagem.provedor}</a>
                  </p>
                )}
              </div>
            </article>
            <nav class="giro__passos" aria-label="Passar notícia">
              {i > 0 && <a class="giro__passo" href={`#${id(i - 1)}`} data-giro-passo="-1">Anterior</a>}
              <a class="giro__passo giro__passo--proxima" href={`#${id(i + 1)}`} data-giro-passo="1">{i + 1 < total ? 'Próxima' : 'Fim'}</a>
            </nav>
          </li>
        );
      })}
      <li class="giro__cena giro__cena--fim" id={id(total)} data-giro-cena={total + 1}>
        <article class="giro__cartao" aria-labelledby="giro-fim">
          <h2 class="giro__manchete" id="giro-fim">Você viu tudo desta edição</h2>
          <p class="giro__resumo">Foram {total} notícias das últimas 48 horas. A próxima edição sai em até 30 minutos, com o que os portais publicarem de novo.</p>
          <div class="giro__acoes">
            <a class="botao" href={caminho()}>Voltar para a capa</a>
            <a class="link giro__fonte" href={`#${id(0)}`} data-giro-inicio>Ver de novo do começo</a>
          </div>
        </article>
      </li>
    </ol>
  </div>
</Base>

<script>
  // Com JavaScript: contador da notícia na tela, setas e teclas j/k para passar, e o foco segue a notícia.
  const lista = document.querySelector<HTMLElement>('[data-giro-lista]');
  const atual = document.querySelector<HTMLElement>('[data-giro-atual]');
  if (lista && atual) {
    const cenas = Array.from(lista.querySelectorAll<HTMLElement>('[data-giro-cena]'));
    const total = cenas.length - 1;
    let indice = 0;
    const suave = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
    const ir = (i: number) => {
      const alvo = cenas[Math.max(0, Math.min(cenas.length - 1, i))];
      // Rola só a lista (scrollIntoView rolaria a página também).
      if (alvo) lista.scrollTo({ top: alvo.offsetTop, behavior: suave() });
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            indice = cenas.indexOf(e.target as HTMLElement);
            atual.textContent = String(Math.min(indice + 1, total));
          }
        },
        { root: lista, threshold: 0.6 },
      );
      cenas.forEach((c) => io.observe(c));
    }

    // Roda do mouse e touchpad: cada gesto passa exatamente um cartão. Enquanto o cartão encaixa, os
    // eventos seguintes do mesmo gesto (inclusive a inércia do touchpad) são ignorados.
    let travado = false;
    let acumulado = 0;
    let soltar: ReturnType<typeof setTimeout> | undefined;
    const destravar = () => {
      clearTimeout(soltar);
      // Espera a inércia acabar: só destrava depois de 250 ms sem nenhum evento de roda.
      soltar = setTimeout(() => { travado = false; acumulado = 0; }, 250);
    };
    lista.addEventListener(
      'wheel',
      (ev) => {
        if (ev.ctrlKey || Math.abs(ev.deltaY) < Math.abs(ev.deltaX)) return; // zoom e rolagem lateral seguem normais
        ev.preventDefault();
        if (travado) { destravar(); return; }
        acumulado += ev.deltaMode === 1 ? ev.deltaY * 40 : ev.deltaY;
        if (Math.abs(acumulado) < 30) return;
        travado = true;
        ir(indice + Math.sign(acumulado));
        destravar();
      },
      { passive: false },
    );

    // Os links "Próxima" e "Anterior" funcionam sem JavaScript; com ele, rolam dentro da lista sem mudar o endereço.
    lista.addEventListener('click', (ev) => {
      const passo = (ev.target as HTMLElement).closest<HTMLAnchorElement>('[data-giro-passo], [data-giro-inicio]');
      if (!passo) return;
      ev.preventDefault();
      ir(passo.dataset.giroInicio !== undefined ? 0 : indice + Number(passo.dataset.giroPasso));
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.altKey || ev.ctrlKey || ev.metaKey) return;
      const alvo = ev.target as HTMLElement;
      if (alvo.closest('input, textarea, select')) return;
      if (ev.key === 'j' || ev.key === 'ArrowDown' || ev.key === 'PageDown') { ev.preventDefault(); ir(indice + 1); }
      else if (ev.key === 'k' || ev.key === 'ArrowUp' || ev.key === 'PageUp') { ev.preventDefault(); ir(indice - 1); }
      else if (ev.key === 'Home') { ev.preventDefault(); ir(0); }
      else if (ev.key === 'End') { ev.preventDefault(); ir(cenas.length - 1); }
    });
  }
</script>

<style>
  /* A página inteira é o Giro: uma barra fina em cima e a lista de cenas, cada uma do tamanho da tela. */
  :global(body.imersivo) { background: var(--chao); height: 100svh; overflow: hidden; }
  .giro { --barra-altura: 64px; height: 100svh; display: grid; grid-template-rows: var(--barra-altura) minmax(0, 1fr); }

  .giro__barra {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px;
    padding-inline: var(--margin);
  }
  .giro__voltar {
    justify-self: start; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px 0 10px;
    border: 1px solid var(--ink); background: transparent; font: 600 var(--step-small) / 1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .giro__voltar:active { transform: scale(0.96); }
  @media (hover: hover) and (pointer: fine) { .giro__voltar:hover { background: var(--ink); color: var(--on-ink); } }
  .giro__nome { font: 400 var(--step-lead) / 1 var(--gotica); letter-spacing: 0; }
  .giro__contador {
    font-family: var(--sans);
    justify-self: end; font-size: var(--step-small); font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums;
  }

  .giro__lista {
    position: relative; overflow-y: auto; overscroll-behavior: contain; scroll-snap-type: y mandatory;
    padding-inline: var(--margin);
  }
  .giro__lista:focus-visible { outline-offset: -3px; }
  @media (prefers-reduced-motion: no-preference) { .giro__lista { scroll-behavior: smooth; } }

  /* Cada cena ocupa a altura visível; a manchete nunca é cortada (conteúdo de terceiros), então a cena pode crescer. */
  .giro__cena {
    min-height: 100%; scroll-snap-align: start; scroll-snap-stop: always;
    display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 12px; padding-block: 4px 16px;
    max-width: 640px; margin-inline: auto;
  }
  .giro__cartao {
    position: relative; background: var(--papel-2); border-top: 3px solid var(--fio); padding: clamp(24px, 5vw, 48px);
    display: grid; align-content: center;
    transition: transform var(--t-press) var(--ease-out);
  }
  .giro__texto { display: grid; gap: 16px; justify-items: start; }
  .giro__manchete { font-size: var(--step-head); line-height: 1.02; letter-spacing: -0.025em; }

  /* O cartão inteiro abre a notícia: o link da manchete se estende sobre ele. Os links do crédito ficam por cima. */
  .giro__abrir {
    text-decoration: underline; text-decoration-thickness: 0.05em; text-decoration-color: transparent;
    transition: text-decoration-color var(--t-hover) ease;
  }
  .giro__abrir::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: var(--raio); }
  .giro__abrir:focus-visible { outline: none; }
  .giro__cartao:has(.giro__abrir:focus-visible) { outline: 3px solid var(--ink); outline-offset: 3px; }
  .giro__cartao:has(.giro__abrir:active) { transform: scale(0.99); }
  @media (hover: hover) and (pointer: fine) { .giro__cartao:hover .giro__abrir { text-decoration-color: currentColor; } }
  .giro__credito { position: relative; z-index: 2; }
  .giro__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font: 600 var(--step-small) / 1.3 var(--sans); }
  .giro__resumo { font-family: var(--serif); font-size: var(--step-lead); line-height: 1.4; max-width: 38ch; }
  .giro__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-top: 4px; }
  .giro__fonte { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration-color: currentColor; }

  .giro__passos { display: flex; justify-content: space-between; gap: 12px; }
  .giro__passo {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 20px;
    border: 1px solid var(--ink); background: transparent; font: 600 var(--step-small) / 1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    transition: background-color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .giro__passo:active { transform: scale(0.96); }
  .giro__passo--proxima { margin-left: auto; }
  @media (hover: hover) and (pointer: fine) { .giro__passo:hover { background: var(--ink); color: var(--on-ink); } }

  .giro__cena--fim .giro__cartao { background: var(--papel); border-bottom: 1px solid var(--fio); }

  /* Com imagem: a foto cobre o cartão e a metade de cima (pelo menos) fica só para ela; o texto fica embaixo,
     em branco. O véu escuro (a exceção à regra "sem gradiente") acompanha o próprio bloco de texto: começa um
     pouco acima dele, com um fade, e fica sólido atrás das letras, o que garante o contraste com qualquer foto. */
  .giro__cartao--foto {
    isolation: isolate; overflow: hidden; padding: 0; border-top: 0;
    grid-template-rows: minmax(0, 1fr) auto; align-content: stretch;
    color: var(--sobre-foto); --medidor-vazio: var(--toque-foto); background: var(--veu-foto);
  }
  /* Para a foto ficar com pelo menos metade do cartão, a manchete vai um degrau abaixo (--step-lead) e o bloco
     de texto é só manchete, medidor e crédito. A manchete nunca é cortada (é de terceiros). */
  .giro__cartao--foto .giro__texto { grid-row: 2; gap: 12px; }
  .giro__cartao--foto .giro__manchete { font-size: var(--step-lead); line-height: 1.12; letter-spacing: -0.01em; }
  .giro__cartao--foto:has(.giro__abrir:focus-visible) { outline-color: var(--ink); }
  .giro__foto { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; }
  .giro__cartao--foto .giro__texto {
    --fade: clamp(48px, 8vh, 88px);
    padding: var(--fade) clamp(20px, 4vw, 40px) clamp(20px, 3.5vw, 32px);
    background: linear-gradient(to bottom, transparent, var(--veu-foto) var(--fade));
  }
  .giro__credito { font: 400 var(--step-small) / 1.4 var(--sans); }
  .giro__credito a { color: inherit; font-weight: 600; text-decoration-color: currentColor; }

  /* Descarte: ao passar, o cartão que sai pelo topo encolhe e esmaece, e o próximo sobe para o lugar.
     Animação ligada à própria rolagem (o dedo ou a roda conduzem); onde o navegador não tem isso, só rola. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .giro__cena { animation-name: descartar; animation-timing-function: linear; animation-fill-mode: both; transform-origin: 50% 0; }
      .giro__cartao { animation-name: chegar; animation-timing-function: linear; animation-fill-mode: both; }
      /* A linha do tempo fica numa regra à parte: no atalho `animation`, o minificador a juntaria e o navegador a descartaria. */
      .giro__lista > .giro__cena { animation-timeline: view(); animation-range: exit 0% exit 100%; }
      .giro__lista .giro__cena > .giro__cartao { animation-timeline: view(); animation-range: entry 0% entry 100%; }
    }
  }
  @keyframes descartar {
    to { transform: translateY(12%) scale(0.86); opacity: 0.15; }
  }
  @keyframes chegar {
    from { transform: translateY(8%); }
  }
  @media (max-width: 640px) {
    .giro__resumo { font-size: var(--step-body); line-height: 1.45; }
  }

  /* Na tela de toque, passar é deslizar: os botões só ocupariam espaço. */
  @media (pointer: coarse) {
    .giro__passos { display: none; }
    .giro__cena { grid-template-rows: minmax(0, 1fr); }
  }
</style>
