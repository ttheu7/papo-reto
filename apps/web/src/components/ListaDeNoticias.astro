---
// Lista de notícias em colunas de jornal, separadas por fios. Com `filtro`, ganha os botões de editoria que filtram
// a lista ali mesmo (sem JavaScript, os botões não aparecem e a lista fica inteira).
import type { Evento } from '../lib/dados';
import Noticia from './Noticia.astro';

// `medidorGeral`: na capa, o indicador de cobertura conta só contra todos os portais (uma roda).
interface Props { eventos: Evento[]; geradoEm: string; filtro?: boolean; mostrarCategoria?: boolean; porVez?: number; medidorGeral?: boolean }
const { eventos, geradoEm, filtro = false, mostrarCategoria = true, porVez = 0, medidorGeral = false } = Astro.props;

const contagem = new Map<string, { nome: string; total: number }>();
for (const e of eventos) {
  if (!e.categoria) continue;
  const c = contagem.get(e.categoria.slug) ?? { nome: e.categoria.nome, total: 0 };
  c.total++;
  contagem.set(e.categoria.slug, c);
}
const editorias = [...contagem.entries()].sort((a, b) => b[1].total - a[1].total);
---
<div class="lista" data-lista data-por-vez={porVez || undefined}>
  {filtro && editorias.length > 1 && (
    <div class="filtro" data-filtro hidden>
      <div class="filtro__botoes" role="group" aria-label="Filtrar por editoria">
        <button type="button" class="filtro__botao" aria-pressed="true" data-valor="">Todas <span>{eventos.length}</span></button>
        {editorias.map(([slug, c]) => (
          <button type="button" class="filtro__botao" aria-pressed="false" data-valor={slug}>{c.nome} <span>{c.total}</span></button>
        ))}
      </div>
      <p class="filtro__status" aria-live="polite" data-status></p>
    </div>
  )}
  <ul class="lista__itens" data-revela>
    {eventos.map((e) => <Noticia evento={e} geradoEm={geradoEm} mostrarCategoria={mostrarCategoria} medidorGeral={medidorGeral} />)}
  </ul>
  {porVez > 0 && eventos.length > porVez && (
    <div class="lista__mais" data-mais hidden>
      <button type="button" class="botao botao--papel">Mostrar mais notícias</button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lista]').forEach((lista) => {
    const itens = Array.from(lista.querySelectorAll<HTMLElement>('.noticia'));
    const porVez = Number(lista.dataset.porVez) || itens.length;
    const mais = lista.querySelector<HTMLElement>('[data-mais]');
    const filtro = lista.querySelector<HTMLElement>('[data-filtro]');
    const status = filtro?.querySelector<HTMLElement>('[data-status]');
    const botoes = Array.from(filtro?.querySelectorAll<HTMLButtonElement>('[data-valor]') ?? []);
    let valor = '';
    let limite = porVez;

    // Mostra só as notícias da editoria escolhida e, sem filtro, só as primeiras `limite`.
    const aplicar = () => {
      let visiveis = 0;
      let cabem = 0;
      for (const item of itens) {
        const daEditoria = !valor || item.dataset.cat === valor;
        if (daEditoria) cabem++;
        const mostra = daEditoria && (valor !== '' || cabem <= limite);
        item.hidden = !mostra;
        if (mostra) visiveis++;
      }
      if (mais) mais.hidden = valor !== '' || visiveis >= itens.length;
      return visiveis;
    };

    if (filtro) filtro.hidden = false;
    aplicar();
    mais?.querySelector('button')?.addEventListener('click', () => {
      const primeiraNova = itens[limite];
      limite += porVez;
      aplicar();
      primeiraNova?.querySelector<HTMLElement>('a')?.focus();
    });
    // A editoria escolhida fica no endereço (?editoria=mundo), para dar para compartilhar e voltar.
    const escolher = (botao: HTMLButtonElement, gravar: boolean) => {
      valor = botao.dataset.valor ?? '';
      for (const b of botoes) b.setAttribute('aria-pressed', String(b === botao));
      const visiveis = aplicar();
      if (status) status.textContent = valor ? `${visiveis} ${visiveis === 1 ? 'notícia' : 'notícias'} de ${botao.firstChild?.textContent?.trim()}` : '';
      if (gravar) {
        const url = new URL(location.href);
        if (valor) url.searchParams.set('editoria', valor);
        else url.searchParams.delete('editoria');
        history.replaceState(null, '', url);
      }
    };
    for (const botao of botoes) botao.addEventListener('click', () => escolher(botao, true));
    const inicial = new URLSearchParams(location.search).get('editoria');
    const botaoInicial = botoes.find((b) => inicial && b.dataset.valor === inicial);
    if (botaoInicial) escolher(botaoInicial, false);
  });
</script>

<style>
  .filtro { display: grid; gap: 8px; padding: 14px 0 6px; }
  .filtro__botoes { display: flex; flex-wrap: wrap; gap: 6px; }
  .filtro__botao {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 12px; cursor: pointer;
    border: 1px solid var(--ink); background: transparent; color: var(--ink);
    font: 600 var(--step-small) / 1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .filtro__botao span { font-variant-numeric: tabular-nums; letter-spacing: 0; color: var(--muted); }
  .filtro__botao:active { transform: scale(0.97); }
  .filtro__botao[aria-pressed='true'] { background: var(--ink); color: var(--on-ink); }
  .filtro__botao[aria-pressed='true'] span { color: inherit; }
  @media (hover: hover) and (pointer: fine) { .filtro__botao[aria-pressed='false']:hover { background: var(--papel-2); } }
  .filtro__status { font: 600 var(--step-small) var(--sans); color: var(--muted); min-height: 1.4em; }
  /* Colunas de jornal: a lista corre de cima para baixo em cada coluna, com fio fino entre elas. */
  .lista__itens { columns: 4 240px; column-gap: calc(var(--gutter) * 2); column-rule: 1px solid var(--fio-claro); }
  .lista__mais { display: flex; justify-content: center; padding-top: var(--gutter); }
</style>
