---
// O medidor de cobertura como figura: dez barras, cheias conforme os portais que noticiaram.
interface Props { cobertura: number }
const { cobertura } = Astro.props;
const cheias = Math.max(0, Math.min(10, cobertura));
const alturas = [62, 78, 54, 100, 70, 88, 60, 94, 72, 84];
const rotulo = cobertura === 1 ? '1 portal noticiou este assunto' : `${cobertura} portais noticiaram este assunto`;
---
<figure class="grande">
  <svg viewBox="0 0 100 64" preserveAspectRatio="none" role="img" aria-label={rotulo}>
    {alturas.map((h, i) => (
      <rect x={i * 10} y={64 - h * 0.64} width="7.2" height={h * 0.64} class={i < cheias ? 'cheia' : 'vazia'} style={`--d:${i}`} />
    ))}
  </svg>
  <figcaption><strong>{cobertura} de 10</strong> portais acompanhados falaram disso</figcaption>
</figure>

<style>
  .grande { margin: 0; display: grid; gap: 16px; }
  .grande svg { width: 100%; height: clamp(160px, 25vw, 380px); }
  .cheia { fill: var(--mint); }
  .vazia { fill: #2a2a2a; }
  figcaption { font-size: var(--step-small); color: var(--on-dark-muted); }
  figcaption strong { color: var(--on-dark); }
  @media (prefers-reduced-motion: no-preference) {
    rect { transform-box: fill-box; transform-origin: bottom; animation: crescer 1000ms var(--ease-expo) both; animation-delay: calc(var(--d) * 50ms + 150ms); }
  }
  @keyframes crescer { from { transform: scaleY(0.15); } }
</style>
