---
// Indicador de cobertura, com duas rodas:
// - a grande conta contra os portais que cobrem a editoria do assunto nesta edição (lib/cobertura.ts);
// - a pequena, encostada nela, conta contra todos os portais acompanhados: um assunto muito relevante
//   acaba saindo também em portais de fora da editoria (um título mundial do Brasil no e-sports, por exemplo).
// Sem editoria (ou se as duas contas dão o mesmo número), só a roda grande, contra todos.
// Na capa (`geral`), só uma roda, contra todos os portais: lá a comparação entre assuntos de editorias
// diferentes precisa da mesma régua.
// Curto nas listas; grande, com "de N", em "Quem noticiou".
import { coberturaPorEditoria, totalDePortais } from '../lib/dados';
import { escalaDoMedidor } from '../lib/cobertura';

// `simbolo`: um globo dentro da roda pequena, só na página da notícia; na versão curta a roda pequena cresce
// para 16 px, para o globo caber.
interface Props { cobertura: number; categoria?: { slug: string; nome: string } | null; grande?: boolean; geral?: boolean; simbolo?: boolean }
const { cobertura, categoria = null, grande = false, geral = false, simbolo = false } = Astro.props;
const totalGeral = Math.max(totalDePortais, cobertura, 1);
const total = geral ? totalGeral : escalaDoMedidor(cobertura, categoria, coberturaPorEditoria, totalDePortais);
const porEditoria = !geral && Boolean(categoria && coberturaPorEditoria.get(categoria.slug)?.size) && total !== totalGeral;
const quais = porEditoria ? `portais que cobrem a editoria ${categoria!.nome}` : 'portais acompanhados';
const rotulo = porEditoria
  ? `Noticiado por ${cobertura} de ${total} ${quais} e por ${cobertura} de ${totalGeral} portais acompanhados`
  : `Noticiado por ${cobertura} de ${total} ${quais}`;

// O traço usa pathLength 100: o quanto falta para fechar o anel é 100 menos a porcentagem.
const falta = (de: number) => 100 - Math.round((cobertura / de) * 100);
const roda = (tamanho: number, espessura: number) => ({ tamanho, espessura, meio: tamanho / 2, raio: (tamanho - espessura) / 2 });
const principal = grande ? roda(96, 8) : roda(24, 2.5);
const satelite = grande ? roda(30, 3) : simbolo ? roda(16, 1.8) : roda(11, 2);
---
{grande ? (
  <figure class="medidor medidor--grande">
    <span class="medidor__anel" aria-hidden="true">
      <svg width={principal.tamanho} height={principal.tamanho} viewBox={`0 0 ${principal.tamanho} ${principal.tamanho}`}>
        <circle class="medidor__trilho" cx={principal.meio} cy={principal.meio} r={principal.raio} stroke-width={principal.espessura} />
        <circle class="medidor__cheio" cx={principal.meio} cy={principal.meio} r={principal.raio} stroke-width={principal.espessura} pathLength="100" style={`--falta:${falta(total)}`} />
      </svg>
      <span class="medidor__meio"><b>{cobertura}</b><small>de {total}</small></span>
      {porEditoria && (
        <span class="medidor__satelite">
          <svg width={satelite.tamanho} height={satelite.tamanho} viewBox={`0 0 ${satelite.tamanho} ${satelite.tamanho}`}>
            <circle class="medidor__trilho" cx={satelite.meio} cy={satelite.meio} r={satelite.raio} stroke-width={satelite.espessura} />
            <circle class="medidor__cheio" cx={satelite.meio} cy={satelite.meio} r={satelite.raio} stroke-width={satelite.espessura} pathLength="100" style={`--falta:${falta(totalGeral)}`} />
          </svg>
          {simbolo && <svg class="medidor__simbolo" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 7.5h14M5 16.5h14" /></svg>}
        </span>
      )}
    </span>
    <figcaption>
      <span><strong>{cobertura} de {total}</strong> {quais} {cobertura === 1 ? 'noticiou' : 'noticiaram'} este assunto</span>
      {porEditoria && <span><strong>{cobertura} de {totalGeral}</strong> contando todos os portais acompanhados ({simbolo ? 'a roda com o globo' : 'a roda pequena'})</span>}
    </figcaption>
  </figure>
) : (
  <span class:list={['medidor medidor--curto', { 'medidor--duplo': porEditoria, 'medidor--com-simbolo': porEditoria && simbolo }]} role="img" aria-label={rotulo} title={rotulo}>
    <svg width={principal.tamanho} height={principal.tamanho} viewBox={`0 0 ${principal.tamanho} ${principal.tamanho}`} aria-hidden="true">
      <circle class="medidor__trilho" cx={principal.meio} cy={principal.meio} r={principal.raio} stroke-width={principal.espessura} />
      <circle class="medidor__cheio" cx={principal.meio} cy={principal.meio} r={principal.raio} stroke-width={principal.espessura} pathLength="100" style={`--falta:${falta(total)}`} />
    </svg>
    <b aria-hidden="true">{cobertura}</b>
    {porEditoria && (
      <span class="medidor__satelite" aria-hidden="true">
        <svg width={satelite.tamanho} height={satelite.tamanho} viewBox={`0 0 ${satelite.tamanho} ${satelite.tamanho}`}>
          <circle class="medidor__trilho" cx={satelite.meio} cy={satelite.meio} r={satelite.raio} stroke-width={satelite.espessura} />
          <circle class="medidor__cheio" cx={satelite.meio} cy={satelite.meio} r={satelite.raio} stroke-width={satelite.espessura} pathLength="100" style={`--falta:${falta(totalGeral)}`} />
        </svg>
        {simbolo && <svg class="medidor__simbolo" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 7.5h14M5 16.5h14" /></svg>}
      </span>
    )}
  </span>
)}

<style>
  .medidor svg { display: block; transform: rotate(-90deg); }
  .medidor circle { fill: none; }
  .medidor__trilho { stroke: var(--medidor-vazio, var(--fio-claro)); }
  .medidor__cheio { stroke: currentColor; stroke-dasharray: 100; stroke-dashoffset: var(--falta); }

  /* A roda pequena (todos os portais), sem número, entra um pouco na borda de baixo, à direita, da
     grande, sobre um disco na cor do fundo, como um selo. */
  .medidor__satelite { position: absolute; display: grid; place-items: center; border-radius: 50%; background: var(--fundo-satelite, var(--papel)); }
  .medidor__satelite svg { position: absolute; inset: 0; }
  /* O globo no meio da roda pequena: traço fino, na cor da tinta, sem girar com a roda. */
  .medidor .medidor__simbolo { position: relative; inset: auto; transform: none; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .medidor--grande .medidor__simbolo { width: 16px; height: 16px; }
  .medidor--curto .medidor__simbolo { width: 10px; height: 10px; stroke-width: 2; }
  .medidor--com-simbolo { margin-right: 8px; }
  .medidor--com-simbolo .medidor__satelite { width: 16px; height: 16px; right: -8px; bottom: -4px; }

  /* Curto: o número de portais no meio do anel. */
  .medidor--curto { position: relative; display: inline-grid; place-items: center; flex: none; width: 24px; height: 24px; vertical-align: middle; }
  .medidor--duplo { margin-right: 2px; }
  .medidor--curto b {
    position: absolute; inset: 0; display: grid; place-items: center;
    font: 600 0.6875rem / 1 var(--sans); letter-spacing: 0; font-variant-numeric: tabular-nums;
  }
  .medidor--curto .medidor__satelite { width: 11px; height: 11px; right: -3px; bottom: -1px; outline: 1.5px solid var(--fundo-satelite, var(--papel)); }

  /* Grande: o número e o "de N" empilhados, os dois centrados no anel; a frase ao lado. */
  .medidor--grande { display: flex; align-items: center; gap: 24px; margin: 0; }
  .medidor__anel { position: relative; flex: none; color: var(--ink); }
  .medidor__meio {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
    text-align: center; line-height: 1;
  }
  .medidor__meio b { font: 700 1.75rem / 1 var(--serif); font-variant-numeric: lining-nums tabular-nums; }
  .medidor__meio small { font: 600 0.6875rem / 1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .medidor--grande .medidor__satelite { width: 30px; height: 30px; right: 0; bottom: 2px; outline: 3px solid var(--fundo-satelite, var(--papel)); }
  .medidor--grande figcaption { display: grid; gap: 6px; font: 400 var(--step-small) / 1.4 var(--sans); color: var(--muted); max-width: 34ch; }
  .medidor--grande strong { color: var(--ink); font-weight: 600; }

  @media (prefers-reduced-motion: no-preference) {
    .medidor--grande .medidor__cheio { animation: encher 900ms var(--ease-expo) 150ms both; }
  }
  @keyframes encher { from { stroke-dashoffset: 100; } }
</style>
