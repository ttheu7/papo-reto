---
// "O que importa hoje" como uma pilha de pastas: cada pasta é um assunto do dia.
// Tocar na aba traz a pasta para a frente. Sem JavaScript, as cinco aparecem em lista.
import type { Evento } from '../lib/dados';
import { caminho, quando } from '../lib/formato';
import Medidor from './Medidor.astro';

interface Props { eventos: Evento[]; geradoEm: string }
const { eventos, geradoEm } = Astro.props;
const cores = ['mint', 'pink', 'white', 'mint', 'pink'];
const posicoesDaAba = ['3%', '24%', '45%', '66%', '12%'];
const portais = (e: Evento) => e.materias.map((m) => m.portal).filter((p, i, a) => a.indexOf(p) === i);
const aba = (e: Evento) => [e.categoria?.nome, portais(e)[0]].filter(Boolean).join(' · ') || 'Assunto';
---
<div class="pilha" data-pilha style={`--n:${eventos.length}`}>
  {eventos.map((e, k) => {
    const primeira = e.materias[0];
    return (
      <article class={`pasta pasta--${cores[k % cores.length]}`} data-pasta={k} style={`--k:${k};--x:${posicoesDaAba[k % 5]}`} aria-labelledby={`pasta-${k}-titulo`}>
        <h2 class="pasta__aba">
          <button type="button" class="pasta__botao" aria-expanded={k === 0 ? 'true' : 'false'} aria-controls={`pasta-${k}`} data-aba={k} tabindex="-1">
            <span class="so-leitor">Assunto {k + 1}: </span>{aba(e)}
          </button>
        </h2>
        <p class="pasta__fita" aria-hidden="true">{e.titulo}</p>
        <div class="pasta__conteudo" id={`pasta-${k}`}>
          <h3 class="pasta__titulo" id={`pasta-${k}-titulo`}>
            <a href={caminho(`evento/${e.id}/`)}>{e.titulo}</a>
          </h3>
          <div class="pasta__acoes">
            <a class="botao" href={caminho(`evento/${e.id}/`)}>Entender o assunto</a>
            {primeira && <a class="link pasta__fonte" href={primeira.url} rel="noopener">Ler no {primeira.portal}{primeira.exigeAssinatura ? ' (exige assinatura)' : ''}</a>}
          </div>
          {e.resumo ? <p class="pasta__resumo">{e.resumo}</p> : <p class="pasta__resumo">Ainda sem resumo. Leia a manchete original direto na fonte.</p>}
          <p class="pasta__cobertura">
            <Medidor cobertura={e.cobertura} />
            <span>{portais(e).join(', ')} · <time datetime={e.publicadoEm}>{quando(e.publicadoEm, geradoEm)}</time></span>
          </p>
        </div>
      </article>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pilha]').forEach((pilha) => {
    const pastas = Array.from(pilha.querySelectorAll<HTMLElement>('[data-pasta]'));
    const n = pastas.length;
    const ativar = (ativa: number, foco = false) => {
      pastas.forEach((p, k) => {
        // A ativa vai para a frente; as outras seguem em ordem circular atrás dela.
        const pos = (k - ativa - 1 + n) % n;
        p.style.setProperty('--pos', String(pos));
        const frente = k === ativa;
        p.classList.toggle('na-frente', frente);
        p.querySelector('.pasta__conteudo')?.toggleAttribute('hidden', !frente);
        p.querySelector('[data-aba]')?.setAttribute('aria-expanded', String(frente));
      });
      if (foco) pastas[ativa]?.querySelector<HTMLElement>('.pasta__titulo a')?.focus({ preventScroll: true });
    };
    pilha.classList.add('montada');
    pastas.forEach((p) => p.querySelector('[data-aba]')?.removeAttribute('tabindex'));
    ativar(0);
    pastas.forEach((p, k) => {
      p.querySelector('[data-aba]')?.addEventListener('click', () => ativar(k));
      p.addEventListener('click', (ev) => {
        if (!p.classList.contains('na-frente') && !(ev.target as HTMLElement).closest('a, button')) ativar(k);
      });
    });
  });
</script>

<style>
  .pilha { display: grid; gap: 24px; padding-inline: var(--margin); }
  .pasta { position: relative; padding: 28px clamp(20px, 3vw, 40px) 40px; color: var(--ink); }
  .pasta--mint { background: var(--mint); }
  .pasta--pink { background: var(--pink); }
  .pasta--white { background: var(--white); }
  .pasta__aba { font: 600 var(--step-small) / 1.2 var(--text); letter-spacing: 0; margin-bottom: 12px; }
  .pasta__botao { all: unset; cursor: pointer; }
  .pasta__botao:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  /* Sem JavaScript a aba é só um rótulo. */
  .pilha:not(.montada) .pasta__botao { pointer-events: none; cursor: default; }
  .pasta__fita { display: none; }
  .pasta__conteudo { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 28px var(--gutter); align-items: start; }
  .pasta__acoes { grid-column: 1 / -1; margin-top: -4px; }
  .pasta__titulo { font-size: var(--step-head); grid-column: 1 / -1; max-width: 24em; }
  .pasta__titulo a { text-decoration: underline; text-decoration-thickness: 0.06em; text-decoration-color: transparent; transition: text-decoration-color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .pasta__titulo a:hover { text-decoration-color: currentColor; } }
  .pasta__resumo { font-size: var(--step-lead); line-height: 1.4; max-width: 46ch; align-self: start; }
    .pasta__cobertura { display: flex; gap: 14px; align-items: center; font-size: var(--step-small); font-weight: 600; justify-self: end; }
  .pasta__cobertura .medidor { font-size: 32px; }
  .pasta__acoes { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; }
  .pasta__fonte { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration-color: currentColor; }

  /* Com JavaScript: a pilha de pastas. */
  .pilha.montada {
    display: grid; gap: 0; padding-top: var(--tab);
    padding-bottom: calc((var(--n) - 1) * var(--folder-step));
    width: min(86vw + 2 * var(--margin), 100%); margin-inline: auto; padding-inline: 0;
  }
  .montada .pasta {
    grid-area: 1 / 1; z-index: var(--pos);
    transform: translateY(calc(var(--pos) * var(--folder-step)));
    transition: transform 520ms var(--ease-expo);
    min-height: 100%;
  }
  .montada .pasta:not(.na-frente) { cursor: pointer; }
  .montada .pasta__aba {
    position: absolute; left: var(--x); bottom: 100%; margin: 0; max-width: 34%;
    background: inherit; height: var(--tab);
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
  }
  .montada .pasta__botao {
    display: flex; align-items: center; height: 100%; padding: 0 30px;
    font-size: var(--step-body); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
  }
  .montada .pasta__botao:focus-visible { outline: 3px solid var(--accent); outline-offset: -6px; }
  .montada .pasta__fita {
    display: block; position: absolute; top: 4px; left: clamp(20px, 3vw, 40px); right: clamp(20px, 3vw, 40px);
    font-weight: 600; font-size: var(--step-small); line-height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: opacity var(--t-ui) ease;
  }
  .montada .na-frente .pasta__fita { opacity: 0; }
  .montada .na-frente { padding-top: 32px; }
  @media (prefers-reduced-motion: no-preference) {
    .montada .na-frente .pasta__conteudo { animation: abrir 520ms var(--ease-expo) both; }
  }
  @keyframes abrir { from { opacity: 0; transform: translateY(16px); } }

  @media (max-width: 760px) {
    .pilha.montada { --folder-step: 58px; --tab: 32px; width: 100%; }
    .montada .pasta__botao { font-size: var(--step-small); padding: 0 22px; }
    .montada .pasta__aba { max-width: 46%; }
    .pasta__conteudo { grid-template-columns: 1fr; }
    .pasta__cobertura { justify-self: start; }
    .montada .pasta__fita { top: 4px; line-height: 20px; }
    .pasta__acoes .botao { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .montada .pasta { transition: none; } }
</style>
