---
// Uma notícia na lista: o chapéu da editoria, a manchete (o link cobre o item), o resumo e a linha de serviço.
import type { Evento } from '../lib/dados';
import { caminho, quando, quemNoticiou, exigeAssinatura } from '../lib/formato';
import Medidor from './Medidor.astro';

interface Props { evento: Evento; geradoEm: string; mostrarCategoria?: boolean; comResumo?: boolean }
const { evento: e, geradoEm, mostrarCategoria = true, comResumo = true } = Astro.props;
const slug = e.categoria?.slug ?? 'geral';
---
<li class="noticia item" data-cat={slug}>
  {mostrarCategoria && e.categoria && <p class="chapeu">{e.categoria.nome}</p>}
  <h3 class="noticia__titulo"><a class="estica" href={caminho(`evento/${e.id}/`)}>{e.titulo}</a></h3>
  {comResumo && e.resumo && <p class="noticia__resumo">{e.resumo}</p>}
  <p class="servico">
    <Medidor cobertura={e.cobertura} categoria={e.categoria} />
    <span>{quemNoticiou(e)}</span>
    <span aria-hidden="true">·</span>
    <time datetime={e.publicadoEm}>{quando(e.publicadoEm, geradoEm)}</time>
    {exigeAssinatura(e) && <span class="assinatura">· Exige assinatura</span>}
  </p>
</li>

<style>
  .noticia { display: grid; gap: 6px; align-content: start; padding: 16px 0 18px; border-bottom: 1px solid var(--fio-claro); break-inside: avoid; }
  .noticia__titulo { font-size: var(--step-body); font-weight: 680; line-height: 1.2; letter-spacing: -0.005em; }
  .noticia__resumo {
    font-size: var(--step-body); line-height: 1.45; color: var(--muted);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .noticia .servico { margin-top: 2px; }
</style>
