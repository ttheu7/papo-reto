---
// Abertura das páginas internas: uma folha com o título. Com `cat`, a folha leva a cor da editoria.
interface Props { id?: string; grande?: boolean; cat?: string }
const { id = 'pagina-titulo', grande = false, cat } = Astro.props;
---
<section class="abre moldura" aria-labelledby={id}>
  <div class:list={['abre__folha', { 'abre--grande': grande, 'abre--cor': cat }]} data-cat={cat} data-revela>
    <slot />
  </div>
</section>

<style>
  .abre { padding-top: var(--gutter); }
  .abre__folha {
    background: var(--papel); border-radius: var(--raio); padding: clamp(28px, 5vw, 72px) clamp(24px, 4vw, 56px);
    display: grid; gap: 20px; justify-items: start;
  }
  .abre--cor { background: var(--cat); }
  .abre__folha :global(h1) { font-size: var(--step-head); max-width: 20em; line-height: 1; }
  .abre--grande :global(h1) { font-size: var(--step-hero); line-height: 0.95; letter-spacing: -0.035em; }
  .abre__folha :global(.abre__apoio) { font-family: var(--serif); font-size: var(--step-lead); line-height: 1.4; max-width: 44ch; }
  .abre__folha :global(.abre__meta) { font-size: var(--step-small); font-weight: 600; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
</style>
