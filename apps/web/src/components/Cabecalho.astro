---
// Abertura das páginas internas, como a abertura de um caderno do jornal: o título grande sobre um fio forte.
interface Props { id?: string; grande?: boolean }
const { id = 'pagina-titulo', grande = false } = Astro.props;
---
<section class="abre moldura" aria-labelledby={id}>
  <div class:list={['abre__folha', { 'abre--grande': grande }]} data-revela>
    <slot />
  </div>
</section>

<style>
  .abre { padding-top: var(--respiro); }
  .abre__folha { display: grid; gap: 14px; justify-items: start; padding-bottom: 18px; border-bottom: 3px solid var(--fio); }
  .abre__folha :global(h1) { font-size: var(--step-head); font-weight: 720; line-height: 1.02; letter-spacing: -0.02em; max-width: 22em; }
  .abre--grande :global(h1) { font-size: var(--step-hero); line-height: 0.98; }
  .abre__folha :global(.abre__apoio) { font: italic 400 var(--step-lead) / 1.4 var(--serif); color: var(--muted); max-width: 48ch; }
  .abre__folha :global(.abre__meta) { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; }
</style>
