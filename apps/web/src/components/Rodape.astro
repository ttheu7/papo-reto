---
import { categorias } from '../lib/dados';
import { caminho, REPOSITORIO } from '../lib/formato';

// O logotipo final é feito de barras: cada letra é uma barrinha do medidor, de altura diferente.
const letras = [
  { l: 'p', h: 78, c: 'mint' }, { l: 'a', h: 100, c: 'white' }, { l: 'p', h: 64, c: 'pink' }, { l: 'o', h: 88, c: 'mint' },
  { l: 'r', h: 70, c: 'pink' }, { l: 'e', h: 94, c: 'white' }, { l: 't', h: 82, c: 'mint' }, { l: 'o', h: 100, c: 'pink' },
];
const ano = new Date().getFullYear();
---
<footer class="rodape escuro">
  <div class="rodape__marca" role="img" aria-label="Papo Reto">
    {[letras.slice(0, 4), letras.slice(4)].map((palavra) => (
      <div class="rodape__palavra">
        {palavra.map((x) => (
          <span class={`bloco bloco--${x.c}`} style={`--h:${x.h}%`}>
            <svg class="bloco__fundo" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true"><rect width="1" height="1" /></svg>
            <span class="bloco__letra" aria-hidden="true">{x.l}</span>
          </span>
        ))}
      </div>
    ))}
  </div>
  <div class="rodape__grade">
    <nav aria-label="Categorias">
      <h2 class="rodape__titulo">Categorias</h2>
      <ul>
        {categorias.categorias.map((c) => <li><a class="link" href={caminho(`categoria/${c.slug}/`)}>{c.nome}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="O site">
      <h2 class="rodape__titulo">O site</h2>
      <ul>
        <li><a class="link" href={caminho()}>O que importa hoje</a></li>
        <li><a class="link" href={caminho('como-funciona/')}>Como funciona</a></li>
        <li><a class="link" href={`${REPOSITORIO}/issues/new`}>Reportar um erro</a></li>
        <li><a class="link" href={REPOSITORIO}>Código no GitHub</a></li>
      </ul>
    </nav>
    <div class="rodape__contato">
      <h2 class="rodape__titulo">Quem faz</h2>
      <p>Projeto acadêmico de estudantes de Ciência da Computação da Unoesc Videira (SC), na disciplina PRATIC IV.</p>
      <p>Grátis, sem anúncio e sem cadastro. As manchetes e as matérias pertencem aos portais citados.</p>
    </div>
  </div>
  <div class="rodape__fim">
    <p>© {ano} Papo Reto</p>
    <a class="botao" href="#topo">Voltar ao topo</a>
  </div>
</footer>

<script>
  const rodape = document.querySelector('.rodape');
  if (rodape && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { rodape.classList.add('visivel'); io.disconnect(); } }), { threshold: 0.15 });
    io.observe(rodape);
  } else rodape?.classList.add('visivel');
</script>

<style>
  .rodape { padding: clamp(112px, 10vw, 160px) var(--margin) 32px; }
  .rodape__marca { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; height: 34svh; min-height: 180px; }
  .rodape__palavra { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; align-items: end; }
  .bloco {
    height: var(--h); display: flex; align-items: flex-end; justify-content: center;
    font-family: var(--display); font-weight: 700; line-height: 0.8; letter-spacing: -0.04em;
    font-size: clamp(3rem, 9vw, 9rem); color: var(--ink); padding-bottom: 0.08em; overflow: hidden; position: relative;
  }
  .bloco__fundo { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bloco__letra { position: relative; }
  .bloco--mint rect { fill: var(--mint); }
  .bloco--pink rect { fill: var(--pink); }
  .bloco--white rect { fill: var(--white); }
  @media (prefers-reduced-motion: no-preference) {
    .js .bloco { transform: scaleY(0.4); transform-origin: bottom; transition: transform 1000ms var(--ease-expo); }
    .js .bloco .bloco__letra { opacity: 0; transition: opacity 600ms var(--ease-out) 300ms; }
    .js .rodape.visivel .bloco { transform: none; }
    .js .rodape.visivel .bloco__letra { opacity: 1; }
    .js .rodape .rodape__palavra > .bloco:nth-child(2) { transition-delay: 60ms; }
    .js .rodape .rodape__palavra > .bloco:nth-child(3) { transition-delay: 120ms; }
    .js .rodape .rodape__palavra > .bloco:nth-child(4) { transition-delay: 180ms; }
  }
  .rodape__grade {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: 40px var(--gutter); margin-top: 56px; font-size: var(--step-small);
  }
  .rodape__grade nav:nth-child(1) { grid-column: 1 / span 4; }
  .rodape__grade nav:nth-child(1) ul { columns: 2; column-gap: 24px; }
  .rodape__grade nav:nth-child(2) { grid-column: 5 / span 4; }
  .rodape__contato { grid-column: 9 / span 4; display: grid; gap: 12px; align-content: start; color: var(--on-dark); }
  .rodape__titulo { font-family: var(--text); font-size: var(--step-small); font-weight: 600; letter-spacing: 0; line-height: 1.4; margin-bottom: 8px; color: var(--on-dark-muted); }
  .rodape li a { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  .rodape__fim { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 56px; font-size: var(--step-small); }
  @media (max-width: 760px) {
    .rodape__marca { grid-template-columns: 1fr; height: auto; }
    .rodape__palavra { height: 22svh; min-height: 120px; }
    .bloco { font-size: 22vw; }
    .rodape__grade nav:nth-child(1), .rodape__grade nav:nth-child(2) { grid-column: span 6; }
    .rodape__grade nav:nth-child(1) ul { columns: 1; }
    .rodape__contato { grid-column: 1 / -1; }
  }
</style>
