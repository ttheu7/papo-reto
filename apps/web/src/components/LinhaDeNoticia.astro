---
import type { Evento } from '../lib/dados';
import { caminho, quando } from '../lib/formato';
import Medidor from './Medidor.astro';

interface Props { evento: Evento; geradoEm: string; mostrarCategoria?: boolean }
const { evento: e, geradoEm, mostrarCategoria = true } = Astro.props;
const exigeAssinatura = e.materias.length > 0 && e.materias.every((m) => m.exigeAssinatura);
const portais = e.materias.map((m) => m.portal).filter((p, i, a) => a.indexOf(p) === i);
---
<li class="linha">
  <span class:list={['linha__marca', e.resumo ? 'linha__marca--explicado' : 'linha__marca--original']}>
    <Medidor cobertura={e.cobertura} />
  </span>
  <div class="linha__corpo">
    <p class="linha__topo">
      <a class="linha__titulo" href={caminho(`evento/${e.id}/`)}>{e.titulo}</a>
      <time class="linha__hora" datetime={e.publicadoEm}>{quando(e.publicadoEm, geradoEm)}</time>
    </p>
    <p class="linha__texto">
      <span class="linha__portal">{mostrarCategoria && e.categoria ? `${e.categoria.nome} · ` : ''}{portais.join(', ')}{exigeAssinatura && <span class="etiqueta"> · exige assinatura</span>}</span>
      {e.resumo ?? 'Manchete original, ainda sem resumo.'}
    </p>
  </div>
</li>

<style>
  .linha { display: grid; grid-template-columns: 64px 1fr; gap: 20px; align-items: start; }
  .linha__marca {
    width: 64px; height: 64px; display: grid; place-items: center; color: var(--ink);
  }
  .linha__marca :global(.medidor) { font-size: 26px; gap: 2px; }
  .linha__marca :global(.medidor span) { width: 3px; }
  .linha__marca--explicado { background: var(--mint); }
  .linha__marca--original { background: var(--pink); }
  .linha__corpo { display: grid; gap: 6px; min-width: 0; }
  .linha__topo { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .linha__titulo {
    font-weight: 600; font-size: var(--step-body); line-height: 1.3;
    text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: transparent;
    transition: text-decoration-color var(--t-hover) ease;
  }
  .linha__titulo::after { content: ''; position: absolute; inset: 0; }
  .linha { position: relative; }
  @media (hover: hover) and (pointer: fine) {
    .linha:hover .linha__titulo { text-decoration-color: currentColor; }
  }
  .linha__titulo:focus-visible { outline: none; }
  .linha:has(.linha__titulo:focus-visible) { outline: 3px solid var(--accent); outline-offset: 6px; }
  .linha__hora { flex: none; font-size: var(--step-small); color: var(--muted); font-variant-numeric: tabular-nums; }
  .linha__texto { font-size: var(--step-body); line-height: 1.5; max-width: 60ch; }
  .linha__portal { font-weight: 600; margin-right: 0.4em; }
  .linha__portal::after { content: ':'; }
  .etiqueta { color: var(--accent); font-weight: 600; }
  @media (max-width: 600px) {
    .linha { grid-template-columns: 52px 1fr; gap: 14px; }
    .linha__marca { width: 52px; height: 52px; }
    .linha__marca :global(.medidor) { font-size: 22px; }
  }
</style>
