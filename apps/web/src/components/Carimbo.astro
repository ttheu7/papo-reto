---
// O carimbo do jornal: "Grátis · sem anúncio · sem cadastro", com "Feito por estudantes" no meio.
// É a assinatura do Papo Reto: um jornal de estudantes, de graça e sem nada em troca.
---
<svg class="carimbo" viewBox="0 0 128 128" role="img" aria-label="Feito por estudantes. Grátis, sem anúncio e sem cadastro.">
  <defs><path id="carimbo-anel" d="M64,64 m-50,0 a50,50 0 1,1 100,0 a50,50 0 1,1 -100,0" /></defs>
  <circle cx="64" cy="64" r="61" fill="none" stroke="currentColor" stroke-width="2.5" />
  <circle cx="64" cy="64" r="42" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text class="carimbo__anel"><textPath href="#carimbo-anel">GRÁTIS · SEM ANÚNCIO · SEM CADASTRO ·</textPath></text>
  <text class="carimbo__meio" x="64" y="61">FEITO POR</text>
  <text class="carimbo__meio" x="64" y="74">ESTUDANTES</text>
</svg>

<style>
  .carimbo { color: var(--ink); transform: rotate(-9deg); }
  .carimbo text { fill: currentColor; font-family: var(--sans); font-weight: 600; }
  .carimbo__anel { font-size: 10.5px; letter-spacing: 2.2px; }
  .carimbo__meio { font-size: 10px; letter-spacing: 0.6px; text-anchor: middle; }
</style>
