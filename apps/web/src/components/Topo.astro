---
// O cabeçalho do jornal: a linha de serviço (data, edição, tema), o nome em gótica entre fios e o menu
// em versalete. Na capa o nome é o h1 e aparece grande; nas outras páginas ele é menor e leva à capa.
import { categorias, eventos } from '../lib/dados';
import { caminho, dataPorExtenso, horaDe } from '../lib/formato';
import { textoDaEdicao } from '../lib/edicao';
import Carimbo from './Carimbo.astro';

interface Props { capa?: boolean }
const { capa = false } = Astro.props;
const geradoEm = eventos.geradoEm;
// "quarta-feira, 4 de novembro": o dia da semana some nas telas mais estreitas.
const [semana, diaDoMes] = dataPorExtenso(geradoEm).split(', ');
const editorias = categorias.categorias.filter((c) => c.total > 0);
// Onde estamos, para marcar o item do menu: o slug da editoria, "giro" ou "como-funciona".
const partes = Astro.url.pathname.split('/').filter(Boolean);
const aqui = partes.at(-1) ?? '';
---
<header class:list={['topo moldura', { 'topo--capa': capa }]}>
  <div class="topo__linha">
    <p class="topo__data"><span class="topo__semana">{semana}, </span>{diaDoMes}</p>
    <p class="topo__edicao"><span class="topo__numero">{textoDaEdicao(geradoEm)} · </span>Edição das {horaDe(geradoEm)}<span class="topo__ha" data-ha={geradoEm}></span></p>
    <div class="topo__direita">
      <span class="topo__gratis">Grátis · sem anúncio</span>
      <button type="button" class="topo__tema" data-tema-botao aria-pressed="false" hidden><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" /></svg>Modo escuro</button>
    </div>
  </div>
  {capa ? (
    <>
      <h1 class="topo__nome" translate="no">Papo Reto</h1>
      <div class="topo__carimbo"><Carimbo /></div>
      <p class="topo__lema">As notícias do dia explicadas em poucas frases, com o link de quem noticiou</p>
    </>
  ) : (
    <a class="topo__nome topo__nome--link" href={caminho()} translate="no" aria-label="Papo Reto, página inicial">Papo Reto</a>
  )}
  <div class="topo__fios" aria-hidden="true"></div>
  <nav class="topo__menu" aria-label="Editorias">
    <ul>
      <li><a href={caminho('#ultimas')}>Últimas</a></li>
      <li><a href={caminho('giro/')} aria-current={aqui === 'giro' ? 'page' : undefined}>Giro</a></li>
      {editorias.map((c) => (
        <li><a href={caminho(`categoria/${c.slug}/`)} aria-current={aqui === c.slug ? 'page' : undefined}>{c.nome}</a></li>
      ))}
      <li><a href={caminho('como-funciona/')} aria-current={aqui === 'como-funciona' ? 'page' : undefined}>Como funciona</a></li>
    </ul>
  </nav>
</header>

<script>
  // Botão de tema: alterna entre claro e escuro e lembra a escolha neste aparelho.
  const botaoTema = document.querySelector<HTMLButtonElement>('[data-tema-botao]');
  if (botaoTema) {
    const raiz = document.documentElement;
    const escuroAgora = () =>
      raiz.dataset.tema ? raiz.dataset.tema === 'escuro' : matchMedia('(prefers-color-scheme: dark)').matches;
    const mostrar = () => botaoTema.setAttribute('aria-pressed', String(escuroAgora()));
    botaoTema.hidden = false;
    mostrar();
    botaoTema.addEventListener('click', () => {
      const tema = escuroAgora() ? 'claro' : 'escuro';
      raiz.dataset.tema = tema;
      try { localStorage.setItem('papo-reto:tema', tema); } catch {}
      mostrar();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', mostrar);
  }

  // "há 12 minutos": quanto tempo faz que esta edição saiu, contado no aparelho de quem lê.
  const alvo = document.querySelector<HTMLElement>('[data-ha]');
  if (alvo?.dataset.ha) {
    const saiu = new Date(alvo.dataset.ha).getTime();
    const escrever = () => {
      const min = Math.max(0, Math.round((Date.now() - saiu) / 60_000));
      if (min > 60 * 24) return;
      alvo.textContent = min < 1 ? ', agora há pouco' : min < 60 ? `, há ${min} min` : `, há ${Math.floor(min / 60)} h`;
    };
    escrever();
    setInterval(escrever, 60_000);
  }
</script>

<style>
  .topo { padding-top: 6px; position: relative; }
  /* O carimbo fica na margem direita do nome, como um carimbo batido na primeira página. */
  .topo__carimbo { position: absolute; right: var(--margin); top: 60px; width: clamp(84px, 9vw, 128px); }
  .topo__linha {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px 16px;
    padding: 6px 0; border-bottom: 1px solid var(--fio);
    font: 600 var(--step-small) / 1.2 var(--sans); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .topo__semana { text-transform: capitalize; }
  .topo__edicao { text-align: center; font-variant-numeric: tabular-nums; }
  .topo__ha { text-transform: none; letter-spacing: 0; color: var(--muted); }
  .topo__direita { display: flex; justify-content: flex-end; align-items: center; gap: 8px 16px; flex-wrap: wrap; }
  .topo__gratis { color: var(--muted); }
  .topo__tema {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 2px; border: 0; background: none; cursor: pointer;
    font: inherit; letter-spacing: inherit; text-transform: inherit; text-decoration: underline; text-decoration-color: transparent;
    transition: text-decoration-color var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) { .topo__tema:hover { text-decoration-color: currentColor; } }
  .topo__nome {
    display: block; text-align: center; font: 400 var(--step-head) / 1 var(--gotica); letter-spacing: 0;
    padding: 14px 0 10px; text-decoration: none;
  }
  .topo--capa .topo__nome { font-size: var(--step-hero); padding: 18px 0 6px; }
  .topo__nome--link { width: fit-content; margin-inline: auto; }
  .topo__lema { text-align: center; font: italic 400 var(--step-body) / 1.3 var(--serif); color: var(--muted); padding-bottom: 12px; }
  .topo__fios { border-top: 3px solid var(--fio); border-bottom: 1px solid var(--fio); height: 7px; }
  .topo__menu { border-bottom: 1px solid var(--fio); overflow-x: auto; scrollbar-width: none; }
  .topo__menu::-webkit-scrollbar { display: none; }
  .topo__menu ul { display: flex; justify-content: center; gap: 0 22px; min-width: max-content; padding: 0 2px; }
  .topo__menu a {
    display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; text-decoration: none;
    font: 600 var(--step-small) / 1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase;
    border-bottom: 2px solid transparent; transition: border-color var(--t-hover) ease;
  }
  .topo__menu a[aria-current='page'] { border-bottom-color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .topo__menu a:hover { border-bottom-color: var(--ink); } }
  @media (max-width: 380px) { .topo__semana { display: none; } }
  @media (max-width: 760px) {
    .topo__linha { grid-template-columns: 1fr auto; letter-spacing: 0.04em; font-size: 0.75rem; }
    .topo__edicao { text-align: right; }
    .topo__gratis { display: none; }
    .topo__numero { display: none; }
    .topo__carimbo { top: 46px; right: var(--margin); width: 54px; }
    .topo__direita { grid-column: 1 / -1; justify-content: flex-start; }
    .topo__tema { min-height: 32px; }
    .topo__menu ul { justify-content: flex-start; }
  }
</style>
