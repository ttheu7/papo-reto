{
  "name": "papo-reto",
  "private": true,
  "description": "Portal de notícias para o público jovem",
  "type": "module",
  "engines": {
    "node": ">=22.23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @papo-reto/web",
    "coletar": "tsx --env-file-if-exists=.env apps/coletor/src/coletar.ts",
    "dados:site": "tsx --env-file-if-exists=.env apps/coletor/src/dados-do-site.ts",
    "build:web": "npm run build -w @papo-reto/web",
    "dev:web": "npm run dev -w @papo-reto/web",
    "db:nova": "supabase migration new",
    "db:status": "supabase migration list --remote",
    "db:push": "supabase db push --remote"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "supabase": "^3.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
